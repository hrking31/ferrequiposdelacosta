rules_version = '2';

// Reglas de seguridad de Cloud Storage — Ferrequipos de la Costa
//
// En el bucket conviven dos tipos de archivo:
//   avatars/{uid}                    -> foto de perfil de cada usuario interno
//   documentos/{clienteId}/{archivo} -> fotos del documento de identidad del cliente
//   {equipoId}/{archivo}             -> imágenes de los equipos del catálogo
//
// Las imágenes de equipos NO van dentro de una carpeta "equipos": CrearEquipos.jsx
// y EditarEquipos.jsx suben a una carpeta con el id del equipo, directamente en la
// raíz del bucket. Por eso la regla de abajo se escribe "todo lo que no sea avatars
// ni documentos".
//
// A PROPÓSITO no se consulta acá el rol del usuario (que vive en Firestore). Hacerlo
// exige habilitar las "llamadas entre servicios" en Google Cloud: un permiso que no
// queda registrado en este repositorio, invisible para quien lea estas reglas, y que
// el 2026-08-07 dejó rotas todas las subidas de imágenes hasta que se descubrió.
// El filtro por rol se sigue aplicando donde de verdad importa: para que un equipo
// aparezca en el catálogo hay que escribir su documento en la colección "equipos",
// y firestore.rules sí exige el rol ahí. Una imagen suelta en el bucket no publica
// nada.

service firebase.storage {
  match /b/{bucket}/o {

    // Fotos de perfil: las ve cualquiera con sesión iniciada (salen en la lista de
    // usuarios) y solo su dueño puede subirla o reemplazarla (HeaderUsuario.jsx).
    match /avatars/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Fotos del documento de identidad de cada cliente (frente y atrás, ver
    // documentoCliente.js). NUNCA públicas: solo con sesión iniciada.
    //
    // Como en el resto de este archivo, acá no se mira el rol. El candado de
    // verdad es el enlace de la foto: vive dentro del cliente en Firestore, y
    // al cliente solo lo leen los roles de la vista clientes. Quien no puede
    // abrir la ficha no tiene el enlace.
    //
    // Al subir, solo imágenes y de hasta 5 MB: la app las achica a unos
    // 300 KB antes de mandarlas, así que algo más grande no viene de ella.
    match /documentos/{clienteId}/{archivo} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches("image/.*");
    }

    // Imágenes de equipos: lectura pública, porque el catálogo y el kiosco se ven
    // sin iniciar sesión. Escritura para cualquier usuario con sesión.
    //
    // OJO: "documentos" tiene que quedar fuera de esta regla. Las reglas de
    // Storage se suman —si una deja pasar, pasa—, así que con solo agregar la
    // de arriba las cédulas seguirían siendo públicas por esta.
    match /{carpeta}/{archivo=**} {
      allow read: if carpeta != "avatars" && carpeta != "documentos";
      allow write: if carpeta != "avatars" && carpeta != "documentos"
        && request.auth != null;
    }
  }
}
