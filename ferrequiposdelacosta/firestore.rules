rules_version = '2';

// Reglas de seguridad de Cloud Firestore — Ferrequipos de la Costa
//
// IMPORTANTE: este archivo es la ÚNICA barrera real de seguridad de la app.
// El mapa de roles del cliente (src/Components/RolesPermisos/RolesPermisos.jsx)
// solo decide qué botones se ven; cualquiera puede saltárselo desde la consola
// del navegador. Si se cambian los roles o permisos ahí, hay que actualizar
// también las funciones de este archivo.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Ayudantes
    // ---------------------------------------------------------------

    // Rol del usuario que hace la petición, leído de users/{uid}.
    // Devuelve "" si no hay sesión, si el documento no existe o si no tiene
    // el campo "role", para que ninguna regla se caiga por leer un campo
    // inexistente (ante la duda, se niega el acceso).
    function rolUsuario() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("role", "")
        : "";
    }

    function tieneRol(roles) {
      return rolUsuario() in roles;
    }

    // Permisos "crearEquipos" y "eliminarEditarEquipos" de RolesPermisos.jsx.
    function puedeGestionarEquipos() {
      return tieneRol(["gestorEditor", "gestorIntegral", "administrador"]);
    }

    // Permisos "clientes" y "gestionCartera" de RolesPermisos.jsx.
    function puedeGestionarClientes() {
      return tieneRol(["gestorFacturacion", "gestorIntegral", "administrador"]);
    }

    // Permiso "cuentaCombro" de RolesPermisos.jsx (sí, con esa grafía: es un
    // error de tipeo del modelo de datos que se mantiene por consistencia).
    // Hoy son los mismos roles que puedeGestionarClientes, pero va aparte
    // porque son permisos distintos y pueden separarse.
    function puedeGestionarCuentasCobro() {
      return tieneRol(["gestorFacturacion", "gestorIntegral", "administrador"]);
    }

    // Permisos "cotizacion" y "solicitudesCotizaciones" de RolesPermisos.jsx.
    function puedeGestionarCotizaciones() {
      return tieneRol(["gestorFacturacion", "gestorIntegral", "administrador"]);
    }

    // Permisos "crearUsuarios" y "eliminarUsuarios": solo el administrador.
    function esAdministrador() {
      return tieneRol(["administrador"]);
    }

    // ---------------------------------------------------------------
    // Catálogo de equipos
    // ---------------------------------------------------------------
    // La tienda web y el kiosco muestran el catálogo SIN iniciar sesión,
    // así que la lectura tiene que quedar abierta.
    match /equipos/{equipoId} {
      allow read: if true;
      allow create, update, delete: if puedeGestionarEquipos();
    }

    // ---------------------------------------------------------------
    // Usuarios internos
    // ---------------------------------------------------------------
    match /users/{userId} {
      // Cada quien lee su propio perfil (AuthContext.jsx). La lista completa
      // (ListaUsuarios.jsx) es solo para el administrador.
      allow get: if request.auth != null
        && (request.auth.uid == userId || esAdministrador());
      allow list: if esAdministrador();

      // Un usuario cualquiera solo puede cambiar SU foto de perfil
      // (HeaderUsuario.jsx) y la lista de equipos donde quiere recibir avisos
      // (Utils/avisos.js). Sin este límite, cualquier empleado podría
      // escribir role: "administrador" en su propio documento desde la
      // consola del navegador y quedar con todos los permisos.
      // El administrador sí puede editar nombre, género, rol y permisos
      // de cualquiera (ListaUsuarios.jsx).
      allow update: if (request.auth != null
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["photoURL", "avisosTokens"]))
        || esAdministrador();

      // Crear y borrar usuarios pasa por las Cloud Functions createUser y
      // deleteUser, que usan el SDK de administrador y no pasan por estas
      // reglas. Desde el navegador queda prohibido.
      allow create, delete: if false;
    }

    // ---------------------------------------------------------------
    // Clientes y sus facturas
    // ---------------------------------------------------------------
    match /clientes/{clienteId} {
      allow read, create, update: if puedeGestionarClientes();

      // BORRAR LA FICHA es solo del administrador (2026-10-16). La app no
      // tiene ese botón, pero la regla dejaba hacerlo desde la consola del
      // navegador: las facturas del cliente quedaban huérfanas —fuera de la
      // lista, con su deuda— y el registro de cambios no lo anotaba.
      allow delete: if esAdministrador();

      // BORRAR UNA FACTURA queda solo en manos del administrador, igual que
      // eliminar una cotizacion o una cuenta de cobro: no se deshace y se
      // lleva los abonos, los despachos y la historia de cada equipo.
      //
      // La regla es la que de verdad lo impide. En la pantalla el boton no se
      // le muestra a nadie mas (ver FacturaCard.jsx), pero eso es comodidad:
      // sin esta linea, cualquiera con permiso de clientes podria borrarla
      // desde la consola del navegador. Es lo mismo que paso con las cuentas
      // de cobro hasta el 2026-08-19.
      match /facturas/{facturaId} {
        allow read, create: if puedeGestionarClientes();
        allow update: if esAdministrador()
          || (puedeGestionarClientes() && soloAnota());
        allow delete: if esAdministrador();
      }
    }

    // ANOTAR NO ES CORREGIR (2026-10-15). Los gestores actualizan la factura
    // todos los días —un abono, una devolución, una llamada—, y hasta acá la
    // base no podía distinguir eso de cambiarle un dato ya escrito. Corregir
    // es solo del administrador (ver CorregirFacturaDialog.jsx).
    //
    // Lo que esta regla le cierra a todos los demás:
    //   - el número y la fecha de la factura no se tocan;
    //   - los abonos, lo devuelto al cliente y las gestiones solo crecen: se
    //     agregan al final, y los que ya estaban quedan idénticos.
    //
    // De paso frena la ventana vieja que guarda una copia sin el abono que
    // otro acaba de anotar: los de antes ya no serían los mismos.
    //
    // Lo que NO alcanza: las fechas, los días, los precios y los descuentos
    // de cada equipo. Viven dentro de los despachos, que los gestores
    // reescriben al devolver o ampliar, y una regla no puede recorrer esas
    // listas para separar "agregó la devolución" de "le cambió la fecha". Eso
    // queda a la vista en el historial de correcciones.
    function soloAnota() {
      let antes = resource.data.get("factura", {});
      let despues = request.resource.data.get("factura", {});
      return despues.get("numeroFactura", null) == antes.get("numeroFactura", null)
        && despues.get("fechaCreacion", null) == antes.get("fechaCreacion", null)
        && soloCrece("abonos")
        && soloCrece("entregas")
        && soloCrece("gestiones");
    }

    // La lista de después empieza con la de antes, tal cual.
    function soloCrece(campo) {
      let antes = resource.data.get(campo, []);
      let despues = request.resource.data.get(campo, []);
      return despues.size() >= antes.size()
        && despues[0:antes.size()] == antes;
    }

    // ---------------------------------------------------------------
    // Cuentas de cobro emitidas
    // ---------------------------------------------------------------
    // Las emite el staff desde la app y quedan guardadas para consultarlas
    // después (ver Components/CuentaDeCobro/cuentasCobroDb.js). No las ve
    // nadie de afuera: son documentos de cobro con datos de clientes.
    //
    // Dos cosas quedan SOLO en manos del administrador, igual que en las
    // cotizaciones: eliminar una cuenta (no se deshace) y darla por pagada
    // (es plata que se declara cobrada, y queda anotado quién lo dijo).
    // Hasta el 2026-08-19 eso era solo de pantalla: el botón no se mostraba,
    // pero la regla dejaba escribir a cualquiera con el permiso.
    match /cuentasCobro/{cuentaId} {
      // Los campos que escribe SOLO el botón de pagada (quién y cuándo).
      function tocaLaMarcaDePago() {
        return request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasAny(["pagadaEn", "pagadaPor"]);
      }

      // Poner una cuenta EN "pagada" viniendo de otro estado.
      //
      // Se permite el regreso legítimo: cuando alguien abre una cuenta ya
      // pagada, esta pasa a "enProceso" y al salir vuelve a "pagada". Ahí
      // `statusPrevio` dice de dónde venía, así que ese camino no es "darla
      // por pagada", es devolverla a como estaba.
      function laDaPorPagada() {
        return request.resource.data.get("status", "") == "pagada"
          && resource.data.get("status", "") != "pagada"
          && resource.data.get("statusPrevio", "") != "pagada";
      }

      allow read: if puedeGestionarCuentasCobro();

      // Una cuenta nace como borrador o emitida; nadie la crea ya pagada.
      allow create: if puedeGestionarCuentasCobro()
        && (esAdministrador()
            || request.resource.data.get("status", "") != "pagada");

      allow update: if puedeGestionarCuentasCobro()
        && (esAdministrador() || (!tocaLaMarcaDePago() && !laDaPorPagada()));

      allow delete: if esAdministrador();
    }

    // ---------------------------------------------------------------
    // Solicitudes de cotización
    // ---------------------------------------------------------------
    // Las crea la Cloud Function crearCotizacion cuando alguien pide una
    // cotización desde la tienda o el kiosco. Esa función escribe con el SDK
    // de administrador y no pasa por estas reglas, así que acá no hace falta
    // (ni conviene) abrirle nada al público: el cliente nunca lee esta
    // colección, solo llama a la función.
    //
    // Vivían en la base en tiempo real, donde lo máximo que se podía exigir
    // era "tener sesión iniciada" —sus reglas no pueden consultar el rol, que
    // está en Firestore—. Por eso cualquier empleado logueado podía borrar
    // solicitudes desde la consola del navegador, aunque no viera el botón.
    // Acá el borrado queda cerrado de verdad: solo el administrador.
    match /cotizaciones/{cotizacionId} {
      allow read, create, update: if puedeGestionarCotizaciones();
      allow delete: if esAdministrador();
    }

    // ---------------------------------------------------------------
    // La pizarra: los totales del panel del menú
    // ---------------------------------------------------------------
    // Un solo documento (resumen/totales) con cuántos equipos están afuera y
    // cuánta plata falta cobrar. Lo mantienen las Cloud Functions
    // ajustarTotalesPanel y recalcularTotalesPanel.
    //
    // Adentro NO hay un solo dato de cliente: son dos números sueltos. Por eso
    // lo puede leer cualquier empleado con sesión, incluido el gestorEditor
    // —que no tiene acceso a clientes ni facturas y por eso hasta ahora no
    // podía ver "Equipos activos", porque calcularlo exigía leerle la cartera
    // entera a la empresa—.
    //
    // Escribir queda prohibido desde el navegador: las funciones usan el SDK
    // de administrador y no pasan por estas reglas. Así el número no lo puede
    // tocar nadie a mano, ni por error ni a propósito.
    match /resumen/{documento} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // El registro de cambios de las facturas
    // ---------------------------------------------------------------
    // Quién tocó cada factura, cuándo, y cómo estaba antes y después. Lo
    // escribe la función anotarCambioDeFactura con el SDK de administrador,
    // que no pasa por estas reglas.
    //
    // Desde el navegador NADIE escribe ni borra: un registro que se puede
    // editar no prueba nada. Y solo lo lee el administrador, que es quien
    // corrige las facturas (ver CorregirFacturaDialog.jsx): adentro va la
    // factura entera, con los datos del cliente.
    match /registroFacturas/{cambioId} {
      allow read: if esAdministrador();
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // Todo lo demás queda cerrado
    // ---------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
